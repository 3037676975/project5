# Project5 runtime configuration
PROJECT5_PORT=8005
ADMIN_KEY=replace-with-a-long-random-admin-key
KOKORO_REPO_ID=hexgrad/Kokoro-82M-v1.1-zh
KOKORO_DEVICE=cpu
# One synthesis request can use up to 8 CPU cores through ONNX Runtime.
KOKORO_THREADS=8
KOKORO_INTER_THREADS=1
# Project5 uses the FP32 export because this server's CPUExecutionProvider does
# not implement the GemmInteger operator used by the INT8 export.
KOKORO_ONNX_MODEL=/www/wwwroot/project5/models/kokoro-v1.1-zh.onnx
KOKORO_ONNX_VOICES=/www/wwwroot/project5/models/voices-v1.1-zh.bin
KOKORO_ONNX_CONFIG=/www/wwwroot/project5/models/config.json
MAX_TEXT_LENGTH=5000
PRELOAD_MODEL=0
